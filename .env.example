# --- CẤU HÌNH SERVER & APPS ---
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TITLE=Bilibili Advanced Downloader

# --- CẤU HÌNH THƯ MỤC & FILE TẢI NẠP ---
DOWNLOAD_DIR=./downloads
LOG_FILE=hi_downloader.log
CONFIG_FILE=config.json
PROXY_FILE=proxies.txt

# --- CẤU HÌNH PROXY XOAY VÒNG (NẾU DÙNG) ---
# Nếu proxies.txt của bạn chỉ có định dạng host:port và yêu cầu tài khoản/mật khẩu chung:
PROXY_USER=
PROXY_PASS=

# --- CẤU HÌNH HIỆU NĂNG TẢI ---
MAX_CONCURRENT_DOWNLOADS=2

# --- CẤU HÌNH DOMAIN & GIAO DIỆN OS ---
BILIBILI_SPACE_DOMAIN=space.bilibili.com
BILIBILI_API_DOMAIN=api.bilibili.com
BILIBILI_VIDEO_BASE_URL=https://www.bilibili.com/video/
DIALOG_TITLE=Chon thu muc luu video

